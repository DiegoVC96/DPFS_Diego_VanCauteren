<!DOCTYPE html>
<html lang="es">

    <%- include('./partials/header') %> <!-- Trae el Header -->

    <!-- Hero Section -->
    <section class="hero animate-fade">
        <div class="hero-bg" style="background-image: url(/images/products/Difuminada.png);"></div>
        <div class="hero-overlay"></div>
    
        <div class="hero-content container">
            <h1 class="font-tech">DOMINA EL <span class="neon-text">HORIZONTE</span> DIGITAL</h1>
            <p>Componentes de alto rendimiento seleccionados para entusiastas.</p>
            <a href="/products" class="btn-primary">EXPLORAR CATÁLOGO</a>
        </div>
    </section>

    <!-- Categorías -->
    <section class="categories container">
        <div class="cat-card font-tech" style="background-image: url('/images/products/CPU_Categoria.png');">
            <div class="cat-overlay"></div>
            <span>PROCESADORES</span>
        </div>
        <div class="cat-card font-tech" style="background-image: url('/images/products/GPU_Categoria.png');">
            <div class="cat-overlay"></div>
            <span>PLACAS DE VIDEO</span>
        </div>
        <div class="cat-card font-tech" style="background-image: url('/images/products/LAP_Categoria.png');">
            <div class="cat-overlay"></div>
            <span>LAPTOPS PRO</span>
        </div>
        <div class="cat-card font-tech" style="background-image: url('/images/products/PER_Categoria.png');">
            <div class="cat-overlay"></div>
            <span>PERIFÉRICOS</span>
        </div>
    </section>

    <!-- Productos -->
    <main class="container">
        <h2 class="section-title font-tech">DESTACADOS</h2>
        <div class="product-grid">
            <article class="product-card">
                <div class="product-img">
                    <img src="/images/products/RTX1.png" alt="GPU">
                </div>
                <div class="product-info">
                    <h3>RTX 4080 Super OC</h3>
                    <p>16GB GDDR6X - Edición Limitada</p>
                    <div class="product-footer">
                        <span class="price-tag">$1.250.000</span>
                        <button class="btn-add">+</button>
                    </div>
                </div>
            </article>

            <article class="product-card">
                <div class="product-img">
                    <img src="/images/products/PROC1.png" alt="CPU">
                </div>
                <div class="product-info">
                    <h3>Core i9-14900K</h3>
                    <p>6.0 GHz - 24 Cores / 32 Threads</p>
                    <div class="product-footer">
                        <span class="price-tag">$850.000</span>
                        <button class="btn-add">+</button>
                    </div>
                </div>
            </article>
            
            <article class="product-card">
                <div class="product-img">
                    <img src="/images/products/RAM1.png" alt="RAM">
                </div>
                <div class="product-info">
                    <h3>HyperDragon RGB Max</h3>
                    <p>16GB DDR4 3600MHz</p>
                    <div class="product-footer">
                        <span class="price-tag">$250.000</span>
                        <button class="btn-add">+</button>
                    </div>
                </div>
            </article>
        </div>
    </main>

    <%- include('./partials/footer') %> <!-- Trae el Footer -->

</body>
</html>


</body>
</html>
