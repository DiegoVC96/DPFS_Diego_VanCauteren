<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeoHorizon Tech | Elite Hardware</title>
    <link href="https://googleapis.com" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Header -->
    <header class="header-main">
        <nav class="container">
            <div class="logo font-tech neon-text"><img src="/images/LOGO NeoHorizon.png"></div>
            <div class="search-container">
                <input type="text" placeholder="Buscar hardware..." class="search-bar">
            </div>
            <div class="nav-actions">
            <% if (locals.user) { %>
                <span class="neon-text">Hola, <%= user.firstName %></span>
                <img src="/images/users/<%= user.image %>" width="30" style="border-radius: 50%">
                <a href="/users/logout" class="nav-link">Cerrar Sesión</a>
            <% } else { %>
                <a href="/users/login" class="nav-link">Login</a>
                <a href="/users/register" class="nav-link">Registro</a>
            <% } %>
            </div>
        </nav>
    </header>