<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="/css/productCart.css">

<body>
    <header class="header-main">
        <nav class="container">
            <div class="logo font-tech neon-text">
                <a href="/"><img src="/images/LOGO NeoHorizon.png"></a>
            </div>
            <a href="/products" class="btn-continue-shopping font-tech">
                <i class="fa-solid fa-arrow-left"></i> SEGUIR COMPRANDO
            </a>
        </nav>
    </header>

    <main class="container cart-wrapper animate-fade">
        <section class="cart-items-section">
            <h1 class="font-tech section-title">TU CARRITO (<%= cart.length %>)</h1>
            
            <div class="cart-list">
                <% if (cart.length > 0) { %>
                    <% cart.forEach((item, index) => { %>
                        <article class="cart-item">
                            <img src="/images/products/<%= item.image %>" alt="<%= item.name %>" class="item-img">
                            <div class="item-details">
                                <h3 class="font-tech"><%= item.name %></h3>
                                <p class="item-variant"><%= item.brand %></p>
                                <p class="item-variant">Precio Unitario: $<%= item.price.toLocaleString('es-AR') %></p>
                            </div>
                            <div class="item-qty">
                                <button class="qty-btn">−</button>
                                <span>1</span>
                                <button class="qty-btn">+</button>
                            </div>
                            <div class="item-price">$<%= item.price.toLocaleString('es-AR') %></div>
                            
                            <form action="/products/cart/remove/<%= index %>" method="POST" style="display:inline;">
                                <button type="submit" class="remove-btn" title="Eliminar">×</button>
                            </form>
                        </article>
                    <% }) %>
                <% } else { %>
                    <div class="empty-cart-msg">
                        <p>Tu carrito está vacío.</p>
                        <a href="/" class="btn-primary">Ver Productos</a>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- RESUMEN DE COMPRA -->
        <aside class="cart-summary-section">
            <div class="summary-card">
                <h2 class="font-tech">RESUMEN</h2>
                
                <% 
                    let total = 0;
                    cart.forEach(item => total += Number(item.price));
                %>

                <div class="summary-line">
                    <span>Subtotal</span>
                    <span>$<%= total.toLocaleString('es-AR') %></span>
                </div>

                <div class="shipping-box">
                    <label class="font-tech">CALCULAR ENVÍO</label>
                    <div class="cp-input-group">
                        <input type="text" placeholder="Código Postal" id="cp-input">
                        <button class="btn-secondary">CALCULAR</button>
                    </div>
                    <p class="shipping-cost">Costo de envío: <span class="neon-text">$0</span></p>
                </div>

                <hr class="divider">

                <div class="summary-line total">
                    <span class="font-tech">TOTAL</span>
                    <span class="neon-text">$<%= total.toLocaleString('es-AR') %></span>
                </div>

                <button class="btn-primary btn-full btn-glow">FINALIZAR COMPRA</button>
                <p class="secure-checkout">🔒 Pago 100% seguro y encriptado</p>
            </div>
        </aside>

        <!-- PRODUCTOS RECOMENDADOS -->
        <section class="related-products-section">
            <h2 class="font-tech section-title">PODRÍA INTERESARTE</h2>
            <div class="related-grid">
            <% relatedProducts.forEach(product => { %>
                <article class="related-card">
                    <div class="related-img-box">
                        <a href="/products/<%= product.id %>">
                            <img src="/images/products/<%= product.image %>" alt="<%= product.name %>">
                        </a>
                    </div>
                    <div class="related-info">
                        <h4 class="font-tech"><%= product.name %></h4>
                        <p class="price-mini">$<%= product.price.toLocaleString('es-AR') %></p>
                        <form action="/products/cart/add/<%= product.id %>" method="POST">
                            <button type="submit" class="btn-add-mini">AGREGAR</button>
                        </form>
                    </div>
                </article>
            <% }) %>
            </div>
        </section>

    </main>
    <%- include('../partials/footer') %>
</body>
</html>
