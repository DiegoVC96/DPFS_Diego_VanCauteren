<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="/css/productDetail.css"> 

<body>
    <header class="header-main">
        <nav class="container">
            <div class="logo font-tech neon-text">
                <a href="/"><img src="/images/LOGO NeoHorizon.png" alt="Logo"></a>
            </div>
            <div class="nav-actions">
                <a href="/" class="nav-link">Volver al Inicio</a>
                <div class="cart-icon">
                    <a href="/products/cart">
                        <svg xmlns="http://w3.org" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="container product-detail-container animate-fade">
        <section class="gallery-column">
            <div class="main-image-box neon-border">
                <img src="/images/products/<%= product.image %>" id="mainImg" data-origin="/images/products/<%= product.image %>" alt="<%= product.name %>">
            </div>
            <div class="thumbnails-row">
                <img src="/images/products/<%= product.image %>" class="thumb active" onclick="selectImage(this)">
                
            </div>
        </section>

        <section class="product-info-panel">
            <h1 class="font-tech"><%= product.name %></h1>
            <p class="sku"><%= product.brand ? product.brand.name : 'NeoHorizon' %> - Elite Series</p>
            
            <div class="price-section">
                <span class="price-tag">$<%= product.price.toLocaleString('es-AR') %></span>
                <span class="stock-status">● Stock Disponible</span>
            </div>

            <hr class="divider">

            <% if (product.variants && product.variants.length > 0) { %>
                <div class="variants-section">
                    <label class="font-tech">VERSIÓN / MODELO</label>
                    <div class="variant-options">
                        <% product.variants.forEach((variant, index) => { %>
                            <button class="variant-btn <%= index === 0 ? 'active' : '' %>">
                                <%= variant.name %>
                            </button>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <div class="purchase-section">
                <form action="/products/cart/add/<%= product.id %>" method="POST">
                    <div class="purchase-section">
                        <div class="quantity-selector">
                            <button type="button" onclick="updateQty(-1)">-</button>
                            <input type="number" name="quantity" value="1" id="qty" readonly>
                            <button type="button" onclick="updateQty(1)">+</button>
                        </div>
                            <button type="submit" class="btn-primary btn-full btn-glow">
                                AÑADIR AL CARRITO
                            </button>
                    </div>
                </form>
            </div>

            <div class="product-description">
                <h3 class="font-tech">DESCRIPCIÓN</h3>
                <p><%= product.description %></p>
            </div>
        </section>
    </main>

    <script>
        const mainImg = document.getElementById('mainImg');
        function updateQty(val) {
            let qty = document.getElementById('qty');
            let current = parseInt(qty.value) + val;
            if (current >= 1) qty.value = current;
        }
        function selectImage(element) {
            mainImg.src = element.src;
            mainImg.setAttribute('data-origin', element.src);
            document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
            element.classList.add('active');
        }
    </script>

    <%- include('../partials/footer') %>
</body>
</html>
