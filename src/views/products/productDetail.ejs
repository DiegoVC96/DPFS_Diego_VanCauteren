<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/header') %> <!-- Trae el Header -->
    <link rel="stylesheet" href="/css/productDetail.css"> 

<body>

    <header class="header-main">
        <nav class="container">
            <div class="logo font-tech neon-text"><img src="/images/LOGO NeoHorizon.png"></div>
            <div class="nav-actions">
                <a href="index.ejs" class="nav-link">Volver al Inicio</a>
                <div class="cart-icon">
                    <svg xmlns="http://w3.org" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </div>
            </div>
        </nav>
    </header>

    <main class="container product-detail-container animate-fade">
        <section class="gallery-column">
            <div class="main-image-box neon-border">
            <img src="/images/products/Product4.png" id="mainImg" data-origin="gpu-principal.jpg" alt="Producto Principal">
            </div>
            <div class="thumbnails-row">
            <img src="/images/products/Product4.png" class="thumb active" 
             onmouseover="previewImage(this.src)" 
             onmouseleave="restoreImage()" 
             onclick="selectImage(this)">
             
            <img src="/images/products/Product3.png" class="thumb" 
             onmouseover="previewImage(this.src)" 
             onmouseleave="restoreImage()" 
             onclick="selectImage(this)">
             
            <img src="/images/products/Product2.png" class="thumb" 
             onmouseover="previewImage(this.src)" 
             onmouseleave="restoreImage()" 
             onclick="selectImage(this)">
            </div>
        </section>

    <section class="product-info-panel">
        <h1 class="font-tech">GIGABYTE RTX 4080 <span class="neon-text">SUPER</span></h1>
        <p class="sku">GAMING OC - 16GB GDDR6X</p>
        
        <div class="price-section">
            <span class="price-tag">$1.340.000</span>
            <span class="stock-status">● Stock Disponible</span>
        </div>

        <hr class="divider">

        <div class="variants-section">
            <label class="font-tech">VERSIÓN</label>
            <div class="variant-options">
                <button class="variant-btn active">Gaming OC</button>
                <button class="variant-btn">Windforce V2</button>
                <button class="variant-btn">AERO (White)</button>
            </div>
        </div>

        <div class="purchase-section">
            <div class="quantity-selector">
                <button onclick="updateQty(-1)">-</button>
                <input type="number" value="1" id="qty" readonly>
                <button onclick="updateQty(1)">+</button>
            </div>
            <button class="btn-primary btn-full">AÑADIR AL CARRITO</button>
        </div>

        <div class="product-description">
            <h3 class="font-tech">ESPECIFICACIONES</h3>
            <ul>
                <li>Powered by NVIDIA DLSS 3</li>
                <li>4th Generation Tensor Cores</li>
                <li>WINDFORCE Cooling System</li>
                <li>RGB Fusion & Protection Metal Back Plate</li>
            </ul>
        </div>
        </section>
        <section class="extra-info-container">
        <!-- Especificaciones Técnicas -->
        <div class="info-block animate-fade">
            <h2 class="font-tech section-line">ESPECIFICACIONES TÉCNICAS</h2>
            <table class="specs-table">
                <tr>
                    <td>Motor de Gráficos</td>
                    <td>NVIDIA® GeForce RTX™ 4080 SUPER</td>
                </tr>
                <tr>
                    <td>Bus Standard</td>
                    <td>PCI Express 4.0</td>
                </tr>
                <tr>
                    <td>Memoria de Video</td>
                    <td>16GB GDDR6X</td>
                </tr>
                <tr>
                    <td>Reloj del Motor</td>
                    <td>2610 MHz (Core Clock)</td>
                </tr>
                <tr>
                    <td>Núcleos CUDA</td>
                    <td>10240</td>
                </tr>
                <tr>
                    <td>Interfaz de Memoria</td>
                    <td>256-bit</td>
                </tr>
            </table>
        </div>

        <!-- Opiniones de Usuarios -->
        <div class="info-block animate-fade">
            <h2 class="font-tech section-line">OPINIONES DE USUARIOS</h2>
            <div class="reviews-wrapper">
                <div class="review-card">
                    <div class="review-header">
                        <span class="user-name">Franco M.</span>
                        <span class="stars">★★★★★</span>
                    </div>
                    <p>"Una bestia total. El rendimiento en 4K es increíble y las temperaturas no pasan los 65 grados."</p>
                </div>
                <div class="review-card">
                    <div class="review-header">
                        <span class="user-name">Lucía G.</span>
                        <span class="stars">★★★★★</span>
                    </div>
                    <p>"Excelente calidad de construcción. El diseño con luces LED es sutil y elegante."</p>
                </div>
            </div>
        </div>
        </section>
    </main>


    <script>
    const mainImg = document.getElementById('mainImg');

    function previewImage(src) {
        mainImg.src = src;
    }

    function restoreImage() {
        mainImg.src = mainImg.getAttribute('data-origin');
    }

    function selectImage(element) {
        const src = element.src;
        mainImg.src = src;
        mainImg.setAttribute('data-origin', src); 
        
        const thumbs = document.querySelectorAll('.thumb');
        thumbs.forEach(t => t.classList.remove('active'));
        element.classList.add('active');
    }
    </script>

    <%- include('../partials/footer') %> <!-- Trae el Footer -->
    
</body>
</html>
