<!DOCTYPE html>
<html lang="es">
        <%- include('../partials/header') %>
        <link rel="stylesheet" href="/css/productForm.css">

<body>
    <main class="container admin-container animate-fade">
        <header class="admin-header">
            <h1 class="font-tech"><%= (typeof product != 'undefined') ? 'EDITAR' : 'CARGAR' %> <span class="neon-text">PRODUCTO</span></h1>
            <p>Panel de Control de Inventario</p>
        </header>

        <form action="/products/<%= (locals.product && product.id) ? product.id + '?_method=PUT' : '' %>" 
                            method="POST" 
                            enctype="multipart/form-data" 
                            class="admin-form">
            
            <div class="form-grid">
                <div class="form-col">
                    <div class="form-group">
                        <label for="name" class="font-tech">NOMBRE DEL PRODUCTO</label>
                        <input type="text" id="name" name="name" value="<%= (typeof product != 'undefined') ? product.name : '' %>" placeholder="Ej: RTX 5080 Ti" required>
                    </div>

                    <div class="form-group">
                        <label for="category" class="font-tech">CATEGORÍA</label>
                        <select id="category" name="category" required>
                            <option value="" disabled <%= (typeof product == 'undefined') ? 'selected' : '' %>>Seleccionar...</option>
                            <option value="cpus" <%= (typeof product != 'undefined' && product.category == 'cpus') ? 'selected' : '' %>>Procesadores</option>
                            <option value="gpus" <%= (typeof product != 'undefined' && product.category == 'gpus') ? 'selected' : '' %>>Placas de Video</option>
                            <option value="peripherals" <%= (typeof product != 'undefined' && product.category == 'peripherals') ? 'selected' : '' %>>Periféricos</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="price" class="font-tech">PRECIO ($)</label>
                            <input type="number" id="price" name="price" value="<%= (typeof product != 'undefined') ? product.price : '' %>" placeholder="0.00" required>
                        </div>
                        <div class="form-group">
                            <label for="colors" class="font-tech">VARIANTE / COLOR</label>
                            <input type="text" id="colors" name="colors" value="<%= (typeof product != 'undefined') ? product.colors : '' %>" placeholder="Ej: RGB / White">
                        </div>
                    </div>
                </div>

                <div class="form-col">
                    <div class="form-group">
                        <label for="description" class="font-tech">DESCRIPCIÓN TÉCNICA</label>
                        <textarea id="description" name="description" rows="5" placeholder="Especificaciones detalladas..."><%= (typeof product != 'undefined') ? product.description : '' %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="image" class="font-tech">IMAGEN DEL PRODUCTO</label>
                        <div class="file-input-wrapper">
                            <input type="file" id="image" name="image" accept="image/*">
                            <span class="file-custom">Subir archivo</span>
                        </div>
                        <% if (typeof product != 'undefined') { %>
                            <p class="current-img">Imagen actual: <span><%= product.image %></span></p>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="admin-actions">
                <button type="submit" class="btn-primary btn-glow font-tech">GUARDAR CAMBIOS</button>
                <a href="/products" class="btn-cancel">CANCELAR</a>
            </div>
        </form>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
