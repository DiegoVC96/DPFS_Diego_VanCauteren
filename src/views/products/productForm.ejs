<!DOCTYPE html>
<html lang="es">
<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/productForm.css">

<body>
    <main class="container admin-container animate-fade">
        <header class="admin-header">
            <h1 class="font-tech"><%= (locals.product && product.id) ? 'EDITAR' : 'CARGAR' %> <span class="neon-text">PRODUCTO</span></h1>
            <p>Panel de Control de Inventario</p>
        </header>

        <form action="/products/<%= (locals.product && product.id) ? product.id + '?_method=PUT' : '' %>" 
              method="POST" 
              enctype="multipart/form-data" 
              class="admin-form">
            
            <div class="form-grid">
                <div class="form-col">
                    <div class="form-group">
                        <label for="name" class="font-tech">NOMBRE DEL PRODUCTO</label>
                        <input type="text" id="name" name="name" value="<%= (locals.product) ? product.name : '' %>" placeholder="Ej: RTX 5080 Ti" required>
                        <!-- Mensaje de Error -->
                        <% if (locals.errors && errors.name) { %>
                        <span class="error-msg-neon"><i class="fa-solid fa-triangle-exclamation"></i> <%= errors.name.msg %></span>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="category" class="font-tech">CATEGORÍA</label>
                        <select id="category" name="category_id" required>
                            <option value="" disabled <%= (!locals.product || !product.category_id) ? 'selected' : '' %>>Seleccionar...</option>
                            
                            <% categories.forEach(category => { %>
                                <option value="<%= category.id %>" 
                                    <%= (locals.product && product.category_id == category.id) ? 'selected' : '' %>>
                                    <%= category.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="brand" class="font-tech">MARCA</label>
                        <select id="brand" name="brand_id" required>
                            <option value="" disabled <%= (!locals.product || !product.brand_id) ? 'selected' : '' %>>Seleccionar Marca...</option>
                            <% brands.forEach(brand => { %>
                                <option value="<%= brand.id %>" 
                                    <%= (locals.product && product.brand_id == brand.id) ? 'selected' : '' %>>
                                    <%= brand.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="price" class="font-tech">PRECIO ($)</label>
                            <input type="number" id="price" name="price" value="<%= (locals.product) ? product.price : '' %>" placeholder="0.00" required>
                        </div>
                    </div>
                </div>

                <div class="form-col">
                    <div class="form-group">
                        <label for="description" class="font-tech">DESCRIPCIÓN TÉCNICA</label>
                        <textarea id="description" name="description" rows="5" placeholder="Especificaciones detalladas..."><%= (locals.product) ? product.description : '' %></textarea>
                        <% if (locals.errors && errors.description) { %>
                        <span class="error-msg-neon"><i class="fa-solid fa-triangle-exclamation"></i> <%= errors.description.msg %></span>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="image" class="font-tech">IMAGEN DEL PRODUCTO</label>
                        <div class="file-input-wrapper">
                            <input type="file" id="image" name="image" accept="image/*">
                            <span class="file-custom">Subir archivo</span>
                        </div>
                        <% if (locals.product && product.image) { %>
                            <p class="current-img">Imagen actual: <span><%= product.image %></span></p>
                            <input type="hidden" name="oldImage" value="<%= product.image %>">
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="admin-actions">
                <button type="submit" class="btn-primary btn-glow font-tech">GUARDAR PRODUCTO</button>
                <a href="/products" class="btn-cancel">CANCELAR</a>
            </div>
        </form>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>

