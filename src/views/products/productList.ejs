<!DOCTYPE html>
<html lang="es">
        <%- include('../partials/header') %>
        <link rel="stylesheet" href="/css/productList.css">

<body>
    <main class="container admin-list-container animate-fade">
            <header class="list-header">
            <% if (locals.keywords) { %>
                <h1 class="font-tech">RESULTADOS PARA: <span class="neon-text">"<%= keywords %>"</span></h1>
            <% } else { %>
                <h1 class="font-tech">GESTIÓN DE <span class="neon-text">INVENTARIO</span></h1>
            <% } %>
            <% if (locals.user && user.category_id == 1) { %>
                <a href="/products/create" class="btn-primary btn-add-new">+ NUEVO PRODUCTO</a>
            <% } %>
            </header>

        <div class="table-wrapper">
            <% if (products.length > 0) { %>
            <table class="admin-table">
                <thead>
                <tr class="font-tech">
                    <th>IMAGEN</th>
                    <th>NOMBRE</th>
                    <th>CATEGORÍA</th>
                    <th>PRECIO</th>
                    <th>ACCIONES</th>
                </tr>
                </thead>
                <tbody>
                    <% products.forEach(product => { %>
                    <tr>
                        <td>
                        <img src="/images/products/<%= product.image %>" alt="<%= product.name %>" class="table-img">
                        </td>
                        <td class="product-name-cell">
                        <strong><%= product.name %></strong>
                        <span>ID: #<%= product.id %></span>
                        </td>
                        <td>
                        <span class="badge"><%= product.category ? product.category.name : 'S/C' %></span>
                        </td>
                        <td class="price-cell">$<%= product.price.toLocaleString('es-AR') %></td>
                        <td class="actions-cell">
                            <% if (locals.user && user.category_id == 1) { %>
                            <!-- ADMIN: EDITAR Y BORRAR -->
                            <a href="/products/<%= product.id %>/edit" class="btn-edit" title="Editar">
                                <svg xmlns="http://w3.org" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
        
                            <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display: inline;">
                                <button type="submit" class="btn-delete" title="Eliminar" onclick="return confirm('¿Eliminar?')">
                                    <svg xmlns="http://w3.org" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                </button>
                            </form>

                            <% } else { %>
                            <!-- USUARIO/VISITANTE: AÑADIR AL CARRITO -->
                            <form action="/products/cart/add/<%= product.id %>" method="POST">
                                <button type="submit" class="btn-add-cart">
                                    <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    AGREGAR
                                </button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
                <% } else { %>
                <!-- SI NO HAY RESULTADOS -->
                <div class="no-results-container animate-fade">
                <div class="no-results-icon">🔍</div>
                <h2 class="font-tech">NO SE ENCONTRARON PRODUCTOS</h2>
                <p>No hay coincidencias para tu búsqueda. ¡Intenta con otras palabras!</p>
                <a href="/products" class="btn-primary" style="margin-top: 20px;">VER TODO EL CATÁLOGO</a>
                </div>
                <% } %>
                </div>
