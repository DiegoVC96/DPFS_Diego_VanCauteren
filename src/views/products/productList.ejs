<!DOCTYPE html>
<html lang="es">
        <%- include('../partials/header') %>
        <link rel="stylesheet" href="/css/productList.css">

<body>
    <main class="container admin-list-container animate-fade">
            <header class="list-header">
            <% if (locals.keywords) { %>
                <h1 class="font-tech">RESULTADOS PARA: <span class="neon-text">"<%= keywords %>"</span></h1>
            <% } else { %>
                <h1 class="font-tech">GESTIÓN DE <span class="neon-text">INVENTARIO</span></h1>
            <% } %>
            <% if (locals.user && user.category_id == 1) { %>
                <a href="/products/create" class="btn-primary btn-add-new">+ NUEVO PRODUCTO</a>
            <% } %>
            </header>

        <div class="table-wrapper">
            <% if (products.length > 0) { %>
            <table class="admin-table">
                <thead>
                <tr class="font-tech">
                    <th>IMAGEN</th>
                    <th>NOMBRE</th>
                    <th>CATEGORÍA</th>
                    <th>PRECIO</th>
                    <th>ACCIONES</th>
                </tr>
                </thead>
                <tbody>
                    <% products.forEach(product => { %>
                    <tr>
                        <td>
                        <img src="/images/products/<%= product.image %>" alt="<%= product.name %>" class="table-img">
                        </td>
                        <td class="product-name-cell">
                        <strong><%= product.name %></strong>
                        <span>ID: #<%= product.id %></span>
                        </td>
                        <td>
                        <span class="badge"><%= product.category ? product.category.name : 'S/C' %></span>
                        </td>
                        <td class="price-cell">$<%= product.price.toLocaleString('es-AR') %></td>
                        <td class="actions-cell">
                            <% if (locals.user && user.category_id == 1) { %>
                            <!-- ADMIN: EDITAR Y BORRAR -->
                            <a href="/products/<%= product.id %>/edit" class="btn-edit" title="Editar">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
        
                            <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display: inline;">
                                <button type="submit" class="btn-delete" title="Eliminar" onclick="return confirm('¿Eliminar producto?')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>

                            <% } else { %>
                            <!-- USUARIO/VISITANTE: AÑADIR AL CARRITO -->
                            <form action="/products/cart/add/<%= product.id %>" method="POST">
                                <button type="submit" class="btn-add-cart" title="Añadir al carrito">
                                    <i class="fa-solid fa-cart-plus"></i> AGREGAR
                                </button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
                <% } else { %>
                <!-- SI NO HAY RESULTADOS -->
                <div class="no-results-container animate-fade">
                <div class="no-results-icon">🔍</div>
                <h2 class="font-tech">NO SE ENCONTRARON PRODUCTOS</h2>
                <p>No hay coincidencias para tu búsqueda. ¡Intenta con otras palabras!</p>
                <a href="/products" class="btn-primary" style="margin-top: 20px;">VER TODO EL CATÁLOGO</a>
                </div>
                <% } %>
                </div>
