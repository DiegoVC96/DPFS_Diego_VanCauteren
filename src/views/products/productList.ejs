<!DOCTYPE html>
<html lang="es">
        <%- include('../partials/header') %>
        <link rel="stylesheet" href="/css/productList.css">

<body>
    <main class="container admin-list-container animate-fade">
        <header class="list-header">
            <h1 class="font-tech">GESTIÓN DE <span class="neon-text">INVENTARIO</span></h1>
            <a href="/products/create" class="btn-primary btn-add-new">+ NUEVO PRODUCTO</a>
        </header>

        <div class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr class="font-tech">
                        <th>IMAGEN</th>
                        <th>NOMBRE</th>
                        <th>CATEGORÍA</th>
                        <th>PRECIO</th>
                        <th>ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Ejemplo de fila de producto -->
                    <tr>
                        <td>
                            <img src="/images/products/RTX1.png" alt="RTX 4080" class="table-img">
                        </td>
                        <td class="product-name-cell">
                            <strong>GIGABYTE RTX 4080 SUPER</strong>
                            <span>SKU: NH-GPU-4080S</span>
                        </td>
                        <td><span class="badge">PLACA DE VIDEO</span></td>
                        <td class="price-cell">$1.340.000</td>
                        <td class="actions-cell">
                            <a href="/products/edit/1" class="btn-edit" title="Editar">
                                <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                            </a>
                            <form action="/products/delete/1?_method=DELETE" method="POST" style="display: inline;">
                                <button type="submit" class="btn-delete" title="Eliminar">
                                    <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <!-- Fin de ejemplo -->
                </tbody>
            </table>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
