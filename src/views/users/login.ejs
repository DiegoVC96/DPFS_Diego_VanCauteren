<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión | NeoHorizon Tech</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="auth-page">

    <div class="auth-container animate-fade">
        <header class="auth-header">
            <a href="/" class="logo font-tech neon-text">NEOHORIZON</a>
            <h1 class="font-tech">BIENVENIDO DE NUEVO</h1>
            <p>Ingresa a tu centro de comando.</p>
        </header>

        <form action="/users/login" method="POST" class="auth-form">
            <div class="form-group">
                <label for="email" class="font-tech">EMAIL</label>
                <input type="email" id="email" name="email" placeholder="agente@neohorizon.com" required 
                    value="<%= locals.oldData ? oldData.email : '' %>"
                    class="<%= locals.errors && errors.email ? 'is-invalid' : '' %>">
                <% if (locals.errors && errors.email) { %>
                <span class="error-msg-neon"><%= errors.email.msg %></span>
                <% } %>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label for="password" class="font-tech">CONTRASEÑA</label>
                    <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
                </div>
                <input type="password" id="password" name="password" placeholder="••••••••" required 
                    class="<%= locals.errors && errors.password ? 'is-invalid' : '' %>">
                <% if (locals.errors && errors.password) { %>
                <span class="error-msg-neon"><%= errors.password.msg %></span>
                <% } %>
            </div>

            <div class="form-options">
                <label class="checkbox-container">
                    <input type="checkbox" name="remember" id="remember">
                    <span class="checkmark"></span>
                    Recordarme en este equipo
                </label>
            </div>

            <button type="submit" class="btn-primary btn-full btn-glow font-tech">ENTRAR AL SISTEMA</button>
            
            <div class="divider-text">O CONTINUAR CON</div>

            <div class="social-auth-grid">
                <button type="button" class="btn-social">Gmail</button>
                <button type="button" class="btn-social">GitHub</button>
            </div>
            
            <p class="auth-footer">
                ¿Aún no eres parte? <a href="/users/register" class="neon-text">Crea tu cuenta aquí</a>
            </p>
        </form>
    </div>

</body>
</html>
