<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión | NeoHorizon Tech</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link href="https://googleapis.com" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="auth-page">

    <div class="auth-container animate-fade">
        <header class="auth-header">
            <a href="index.ejs" class="logo font-tech neon-text">NEOHORIZON</a>
            <h1 class="font-tech">BIENVENIDO DE NUEVO</h1>
            <p>Ingresa a tu centro de comando.</p>
        </header>

        <form class="auth-form">
            <div class="form-group">
                <label for="email" class="font-tech">EMAIL</label>
                <input type="email" id="email" placeholder="agente@neohorizon.com" required>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label for="password" class="font-tech">CONTRASEÑA</label>
                    <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
                </div>
                <input type="password" id="password" placeholder="••••••••" required>
            </div>

            <div class="form-options">
                <label class="checkbox-container">
                    <input type="checkbox">
                    <span class="checkmark"></span>
                    Recordarme en este equipo
                </label>
            </div>

            <button type="submit" class="btn-primary btn-full btn-glow font-tech">ENTRAR AL SISTEMA</button>
            
            <div class="divider-text">O CONTINUAR CON</div>

            <div class="social-auth-grid">
                <button type="button" class="btn-social">
                    <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-2.21 5.39-7.84 5.39-4.84 0-8.79-4.01-8.79-8.92s3.95-8.92 8.79-8.92c2.76 0 4.61 1.18 5.66 2.18l2.59-2.5c-1.66-1.55-3.82-2.5-8.25-2.5C5.43 0 0 5.43 0 12s5.43 12 12 12c6.88 0 11.5-4.84 11.5-11.75 0-.79-.08-1.39-.24-1.99h-10.78z"/></svg>
                    Gmail
                </button>
                <button type="button" class="btn-social">
                    <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    GitHub
                </button>
            </div>
            
            <p class="auth-footer">
                ¿Aún no eres parte? <a href="register.ejs" class="neon-text">Crea tu cuenta aquí</a>
            </p>
        </form>
    </div>

</body>
</html>
